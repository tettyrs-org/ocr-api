# secret.yaml.example - Kubernetes Secret template
#
# USAGE:
# 1. cp secret.yaml.example secret.yaml
# 2. Edit secret.yaml dengan actual production values
# 3. kubectl apply -f secret.yaml
#
# DO NOT commit secret.yaml to git!
# Only secret.yaml.example (template) should be in git

apiVersion: v1
kind: Secret
metadata:
  name: ocr-api-secrets
  namespace: default
type: Opaque
stringData:
  # JWT Configuration (RSA)
  # Private and public keys are embedded in the container image at classpath:privateKey.pem and classpath:publicKey.pem
  jwt-private-key-location: "classpath:privateKey.pem"
  jwt-public-key-location: "classpath:publicKey.pem"
  jwt-issuer: "https://${YOUR_DOMAIN}"
  jwt-audiences: "ocr-api"
  jwt-algorithm: "RS256"
  jwt-expiration: "86400"

  # Database Credentials
  db-host: "postgres.default.svc.cluster.local"
  db-port: "5432"
  db-name: "${DB_NAME}"
  db-user: "${DB_USER}"
  db-password: "CHANGE_ME_WITH_SECURE_PASSWORD"

  # Redis Configuration
  redis-host: "redis.default.svc.cluster.local"
  redis-port: "6379"
  redis-password: ""
  redis-db: "0"

  # MinIO/S3 Configuration
  s3-endpoint: "http://minio.default.svc.cluster.local:9000"
  s3-bucket: "ocr-documents"
  aws-region: "us-east-1"
  aws-access-key-id: "CHANGE_ME_WITH_MINIO_USER"
  aws-secret-access-key: "CHANGE_ME_WITH_MINIO_PASSWORD"

  # Application Configuration
  quarkus-profile: "prod"
  cors-origins: "https://${YOUR_DOMAIN}"
