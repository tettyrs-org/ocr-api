# secret.yaml.example - Kubernetes Secret template
#
# USAGE:
# 1. cp secret.yaml.example secret.yaml
# 2. Edit secret.yaml dengan actual production values
# 3. kubectl apply -f secret.yaml
#
# DO NOT commit secret.yaml to git!
# Only secret.yaml.example (template) should be in git

apiVersion: v1
kind: Secret
metadata:
  name: ocr-api-secrets
  namespace: default
type: Opaque
stringData:
  # JWT Configuration (RSA)
  # Private and public keys are embedded in the container image at classpath:privateKey.pem and classpath:publicKey.pem
  jwt-private-key-location: "classpath:privateKey.pem"
  jwt-public-key-location: "classpath:publicKey.pem"
  jwt-issuer: "${YOUR_DOMAIN}"  # e.g., https://${YOUR_DOMAIN}
  jwt-audiences: "${JWT_AUDIENCES}"  # e.g., ocr-api
  jwt-algorithm: "RS256"
  jwt-expiration: "86400"

  # Database Credentials
  db-host: "${DB_HOST}"  # e.g., postgres.default.svc.cluster.local
  db-port: "${DB_PORT}"  # e.g., 5432
  db-name: "${DB_NAME}"  # e.g., ocr_db
  db-user: "${DB_USER}"  # e.g., ${DB_USER}
  db-password: "${DB_PASSWORD}"  # Use strong password

  # Redis Configuration
  redis-host: "${REDIS_HOST}"  # e.g., redis.default.svc.cluster.local
  redis-port: "${REDIS_PORT}"  # e.g., 6379
  redis-password: "${REDIS_PASSWORD}"  # Leave empty if no auth
  redis-db: "${REDIS_DB}"  # e.g., 0

  # MinIO/S3 Configuration
  s3-endpoint: "${S3_ENDPOINT}"  # e.g., http://minio:9000
  s3-bucket: "${S3_BUCKET}"  # e.g., ocr-documents
  aws-region: "${AWS_REGION}"  # e.g., us-east-1
  aws-access-key-id: "${AWS_ACCESS_KEY_ID}"  # MinIO access key
  aws-secret-access-key: "${AWS_SECRET_ACCESS_KEY}"  # MinIO secret key

  # Application Configuration
  quarkus-profile: "prod"
  cors-origins: "${CORS_ORIGINS}"  # e.g., https://${YOUR_DOMAIN}
